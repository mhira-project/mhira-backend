{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "roots": [
        "<rootDir>/test/cache"
    ],
    "testEnvironment": "node",
    "testRegex": "\\.cache-test\\.ts$",
    "transform": {
        "/node_modules/@ptc-org/nestjs-query-typeorm/node_modules/uuid/.+\\.js$": [
            "ts-jest",
            {
                "tsconfig": {
                    "allowJs": true
                }
            }
        ],
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
        "^(?!.*/@ptc-org/nestjs-query-typeorm/node_modules/uuid/).*/node_modules/"
    ],
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
        "<rootDir>/test/services.ts"
    ]
}
