{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "roots": ["<rootDir>/test/cache"],
    "testEnvironment": "node",
    "testRegex": "\\.cache-test\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1",
        "^uuid$": "<rootDir>/node_modules/uuid"
    }
}
