{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "roots": ["<rootDir>/test/db"],
    "testEnvironment": "node",
    "testRegex": "\\.db-test\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    }
}
