{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "roots": ["<rootDir>/test/db"],
    "testEnvironment": "node",
    "testRegex": "\\.db-test\\.ts$",
    "transform": {
        "/node_modules/@ptc-org/nestjs-query-typeorm/node_modules/uuid/.+\\.js$": ["ts-jest", { "tsconfig": { "allowJs": true } }],
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
        "^(?!.*/@ptc-org/nestjs-query-typeorm/node_modules/uuid/).*/node_modules/"
    ],
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    }
}
