{
    "name": "mhira-api",
    "version": "1.1.6",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": "^20.20.2"
    },
    "scripts": {
        "commit": "cz",
        "prebuild": "rimraf dist",
        "build": "npm run prebuild && nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "npm run prebuild && nest start",
        "start:dev": "npm run prebuild && nest start --watch",
        "start:debug": "npm run prebuild && nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:db": "jest --config ./test/jest-db.json --runInBand",
        "test:cache": "jest --config ./test/jest-cache.json --runInBand"
    },
    "dependencies": {
        "@apollo/server": "^4.13.0",
        "@graphql-tools/utils": "^10.11.0",
        "@keyv/redis": "^5.1.6",
        "@nestjs-modules/mailer": "~1.9.1",
        "@nestjs/apollo": "12.2.2",
        "@nestjs/common": "^10.4.22",
        "@nestjs/core": "^10.4.22",
        "@nestjs/graphql": "12.2.2",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mongoose": "^10.1.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.22",
        "@nestjs/schedule": "^4.1.2",
        "@nestjs/typeorm": "^10.0.2",
        "@ptc-org/nestjs-query-core": "9.4.0",
        "@ptc-org/nestjs-query-graphql": "9.4.0",
        "@ptc-org/nestjs-query-typeorm": "9.4.0",
        "argon2": "^0.26.2",
        "bcryptjs": "^2.4.3",
        "bipsms": "^0.6.8",
        "bluebird": "^3.7.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "commitizen": "^4.2.1",
        "crypto-js": "^4.1.1",
        "dataloader": "^2.0.0",
        "dotenv": "^8.2.0",
        "graphql": "^16.0.0",
        "graphql-upload": "^13.0.0",
        "handlebars": "^4.7.7",
        "keyv": "^5.6.0",
        "moment": "^2.27.0",
        "mongoose": "^8.24.8",
        "node-xlsx": "^0.16.1",
        "nodemailer": "^6.8.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.0.3",
        "reflect-metadata": "0.2.2",
        "rimraf": "^3.0.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.31",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.22",
        "@types/bluebird": "^3.5.42",
        "@types/express": "^4.17.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^13.9.1",
        "@types/node-xlsx": "^0.15.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^2.0.8",
        "@typescript-eslint/eslint-plugin": "^2.23.0",
        "@typescript-eslint/parser": "^2.23.0",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^6.8.0",
        "eslint-config-prettier": "^6.10.0",
        "jest": "^29.7.0",
        "prettier": "^1.19.1",
        "supertest": "^4.0.2",
        "ts-jest": "29.3.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^3.9.0",
        "typescript": "~4.9.5"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        }
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
