{
    "name": "mhira-api",
    "version": "1.1.6",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": "^18.20.8"
    },
    "scripts": {
        "commit": "cz",
        "prebuild": "rimraf dist",
        "build": "npm run prebuild && nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "npm run prebuild && nest start",
        "start:dev": "npm run prebuild && nest start --watch",
        "start:debug": "npm run prebuild && nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs-modules/mailer": "^1.8.1",
        "@nestjs-query/query-graphql": "^0.28.1",
        "@nestjs-query/query-typeorm": "^0.28.1",
        "@nestjs/common": "^8.4.7",
        "@nestjs/core": "^8.4.7",
        "@nestjs/graphql": "^8.0.2",
        "@nestjs/jwt": "^8.0.1",
        "@nestjs/mongoose": "^10.1.0",
        "@nestjs/passport": "^8.2.2",
        "@nestjs/platform-express": "^8.4.7",
        "@nestjs/schedule": "^1.1.0",
        "@nestjs/typeorm": "~8.0.5",
        "apollo-server-express": "^2.17.0",
        "argon2": "^0.26.2",
        "bcryptjs": "^2.4.3",
        "bipsms": "^0.6.8",
        "cache-manager": "^3.4.3",
        "cache-manager-mongodb": "^0.3.0",
        "cache-manager-redis-store": "^2.0.0",
        "class-transformer": "^0.2.3",
        "class-validator": "^0.13.2",
        "commitizen": "^4.2.1",
        "crypto-js": "^4.1.1",
        "dataloader": "^2.0.0",
        "graphql": "^15.0.0",
        "graphql-upload": "^11.0.0",
        "handlebars": "^4.7.7",
        "moment": "^2.27.0",
        "mongoose": "^7.8.13",
        "node-xlsx": "^0.16.1",
        "nodemailer": "^6.8.0",
        "passport": "^0.4.1",
        "passport-jwt": "^4.0.0",
        "pg": "^8.0.3",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.2.24",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^8.2.8",
        "@nestjs/schematics": "^8.0.11",
        "@nestjs/testing": "^8.4.7",
        "@types/cache-manager": "^3.4.0",
        "@types/express": "^4.17.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^13.9.1",
        "@types/node-xlsx": "^0.15.1",
        "@types/passport-jwt": "^3.0.3",
        "@types/supertest": "^2.0.8",
        "@typescript-eslint/eslint-plugin": "^2.23.0",
        "@typescript-eslint/parser": "^2.23.0",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^6.8.0",
        "eslint-config-prettier": "^6.10.0",
        "jest": "^29.7.0",
        "prettier": "^1.19.1",
        "supertest": "^4.0.2",
        "ts-jest": "29.3.4",
        "ts-node": "^8.6.2",
        "tsconfig-paths": "^3.9.0",
        "typescript": "~4.9.5"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        }
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
